@model IEnumerable<WebApplication1.Models.AdminBillHistoryViewModel>
@using System.Linq
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Admin Bills History";
    var bills = Model ?? Enumerable.Empty<WebApplication1.Models.AdminBillHistoryViewModel>();
}

<main class="admin-bills-page">
    <header class="admin-bills-page-header">
        <div>
            <p class="dashboard-kicker mb-2">PMP Supermarket Billing System</p>
            <h1>Admin Bills History</h1>
            <p>Review all bills generated by registered users.</p>
        </div>
        <a class="btn btn-outline-secondary" href="@Url.Action("AdminDashboard", "Account")">Back to Admin Dashboard</a>
    </header>

    <section class="admin-bills-card" aria-labelledby="admin-bills-title">
        <h2 id="admin-bills-title">All User Bills</h2>
        <div class="admin-bills-table-scroll">
            <table class="admin-bills-table">
                <thead>
                    <tr><th>User ID</th><th>Username</th><th>Total Amount (&#8377;)</th><th>View Bill</th></tr>
                </thead>
                <tbody>
                    @foreach (var bill in bills)
                    {
                        <tr>
                            <td>@bill.UserId</td>
                            <td>@bill.Username</td>
                            <td>&#8377;@bill.TotalAmount.ToString("N2")</td>
                            <td><a class="btn btn-sm btn-outline-success" href="@Url.Action("AdminBillDetails", "Account", new { billId = bill.BillId })">View Bill</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!bills.Any())
        {
            <p class="admin-bills-empty">No bills have been generated yet.</p>
        }
    </section>
</main>
