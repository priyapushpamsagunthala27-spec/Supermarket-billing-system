@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Admin Dashboard";
}

<main class="dashboard-page">
    <div class="dashboard-hero">
        <div class="dashboard-brand-lockup">
            <div class="pmp-logo dashboard-logo" aria-label="PMP Supermarket">PMP</div>
            <div>
                <p class="dashboard-kicker mb-1">PMP Supermarket Billing System</p>
                <h1 class="dashboard-title mb-2">Admin Dashboard</h1>
                <p class="dashboard-intro mb-0">Keep your product catalogue organized and ready for every checkout.</p>
            </div>
        </div>
        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "dashboard-logout" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-light">Logout</button>
        }
    </div>

    <section aria-labelledby="catalogue-title">
        <div class="dashboard-section-heading">
            <div>
                <p class="dashboard-kicker mb-1">Catalogue workspace</p>
                <h2 id="catalogue-title" class="h4 mb-0">Product management</h2>
            </div>
            <span class="dashboard-status"><span class="dashboard-status-dot"></span>Admin access</span>
        </div>

        <div class="dashboard-card-grid">
            <a class="dashboard-card" href="@Url.Action("Add", "Product")">
                <span class="dashboard-card-icon icon-add" aria-hidden="true">+</span>
                <span class="dashboard-card-content">
                    <strong>Add Product</strong>
                    <span>Create a new item for the supermarket catalogue.</span>
                </span>
                <span class="dashboard-card-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <a class="dashboard-card" href="@Url.Action("Update", "Product")">
                <span class="dashboard-card-icon icon-update" aria-hidden="true">&#9998;</span>
                <span class="dashboard-card-content">
                    <strong>Update Product</strong>
                    <span>Review and refresh existing product information.</span>
                </span>
                <span class="dashboard-card-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <a class="dashboard-card" href="@Url.Action("Delete", "Product")">
                <span class="dashboard-card-icon icon-delete" aria-hidden="true">&#128465;</span>
                <span class="dashboard-card-content">
                    <strong>Delete Product</strong>
                    <span>Remove discontinued items from the catalogue.</span>
                </span>
                <span class="dashboard-card-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <a class="dashboard-card" href="@Url.Action("Index", "Product")">
                <span class="dashboard-card-icon icon-search" aria-hidden="true">&#128269;</span>
                <span class="dashboard-card-content">
                    <strong>View Products</strong>
                    <span>Find products quickly across the store catalogue.</span>
                </span>
                <span class="dashboard-card-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <a class="dashboard-card" href="@Url.Action("AdminBillsHistory", "Account")">
                <span class="dashboard-card-icon icon-search" aria-hidden="true">&#128196;</span>
                <span class="dashboard-card-content">
                    <strong>Bill Transaction</strong>
                    <span>Review bills generated by supermarket users.</span>
                </span>
                <span class="dashboard-card-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <div class="dashboard-card dashboard-sales-card">
                <span class="dashboard-card-icon icon-sales" aria-hidden="true">&#8721;</span>
                <span class="dashboard-card-content">
                    <strong>Sales Statistics</strong>
                    <span>Explore today's category mix and monthly movement.</span>
                    <span class="dashboard-sales-links"><a href="@Url.Action("Today", "Sales")">Today's Sale Statistics</a><br /><a href="@Url.Action("Monthly", "Sales")">Monthly Sales Statistics</a></span>
                </span>
            </div>
        </div>
    </section>
</main>
