@model WebApplication1.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Sign in";
}

<div class="account-page">
    <section class="account-shell" aria-labelledby="login-title">
        <div class="text-center">
            <div class="pmp-logo" aria-label="PMP Supermarket">PMP</div>
            <h1 id="login-title" class="account-title h3">Welcome back</h1>
            <p class="account-subtitle mb-4">Sign in to PMP Supermarket Billing</p>
        </div>

        @if (TempData["RegistrationMessage"] != null)
        {
            <div class="alert alert-success">@TempData["RegistrationMessage"]</div>
        }
        @if (TempData["LoginError"] != null)
        {
            <div class="alert alert-danger">@TempData["LoginError"]</div>
        }
        @Html.ValidationSummary(true, "Sign in was not successful.", new { @class = "alert alert-danger" })

        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "mt-3" }))
        {
            @Html.AntiForgeryToken()
            <div class="mb-3">
                @Html.LabelFor(model => model.Username, new { @class = "form-label fw-semibold" })
                @Html.TextBoxFor(model => model.Username, new { @class = "form-control", autocomplete = "username", autofocus = "autofocus" })
                @Html.ValidationMessageFor(model => model.Username, null, new { @class = "text-danger small" })
            </div>
            <div class="mb-4">
                @Html.LabelFor(model => model.Password, new { @class = "form-label fw-semibold" })
                @Html.PasswordFor(model => model.Password, new { @class = "form-control", autocomplete = "current-password" })
                @Html.ValidationMessageFor(model => model.Password, null, new { @class = "text-danger small" })
            </div>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-success btn-lg">Login</button>
                @Html.ActionLink("Register", "Register", "Account", null, new { @class = "btn btn-outline-success btn-lg" })
            </div>
        }
    </section>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
