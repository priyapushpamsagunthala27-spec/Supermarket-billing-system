@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = ViewBag.Feature;
}

<main class="dashboard-page">
    <div class="feature-placeholder">
        <div class="pmp-logo dashboard-logo" aria-label="PMP Supermarket">PMP</div>
        <p class="dashboard-kicker mb-2">Product management</p>
        <h1 class="h2 mb-3">@ViewBag.Feature</h1>
        <p class="text-muted mb-4">This workspace is coming soon. Product operations will be added in a future update.</p>
        <a class="btn btn-success" href="@Url.Action("AdminDashboard", "Account")">Back to dashboard</a>
    </div>
</main>